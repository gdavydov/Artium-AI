# Postgres / Supabase connection — used by Prisma (schema.prisma, migrations)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Object storage — S3 or Cloudflare R2 (see src/storage/storage.provider.ts)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
MEDIA_BUCKET=

PORT=4000
